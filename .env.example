# Required on Vercel. Local fallback is anv-admin when NODE_ENV is not production.
ADMIN_PASSWORD=anv-admin

# Required on Vercel so admin uploads and edits persist. The Vercel filesystem is read-only.
BLOB_READ_WRITE_TOKEN=

# Public Stripe donation page. Falls back to the live Donate link if unset.
NEXT_PUBLIC_STRIPE_DONATION_URL=https://donate.stripe.com/dR615Z1P6eHrg6c000

# Neon Postgres for admin edits when Blob is not configured.
DATABASE_URL=
